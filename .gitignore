# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS & Windows
.DS_Store
Thumbs.db
*.tmp

# Environment variables & secrets (NEVER commit secrets)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# Local databases, storage & caches
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
server/data/*.json
server/data/backups/
server/data/*.json
server/data/backups/
server/test_tmp/

# Credentials & OAuth tokens
credentials.json
token.json

# Test artifacts, screenshots & dumps
*.png
*.jpg
*.jpeg
*.xml
test_dump.xml
test_device_dump.xml

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI cache
supabase/.temp/
