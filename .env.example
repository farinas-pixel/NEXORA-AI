# ==============================================================================
# NEXORA AI — Environment Variables Template
# STRICT ₹0 BUDGET ARCHITECTURE
#
# INSTRUCTIONS:
# 1. Copy this file to .env before starting the app: `cp .env.example .env`
# 2. Add your free-tier keys.
# 3. NEVER commit the real .env file or any secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API GATEWAY (Free Tier on Render / Koyeb / Local)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE PERSISTENCE & AUTH (Free Tier: 50,000 MAU, 500MB DB)
# Retrieve from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------------------------------------------
# AI PROVIDERS (BACKEND PROXY KEYS — DO NOT EXPOSE IN CLIENT BUNDLE)
# Note: In production, LLM keys are held only by the backend gateway.
# Free-tier references:
# - Google AI Studio (Gemini 2.0 Flash: 15 RPM / 1M TPM): https://aistudio.google.com/
# - Groq Cloud (Llama 3.3 70B & Whisper): https://console.groq.com/
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-free-api-key
# GROQ_API_KEY=your-groq-free-api-key
